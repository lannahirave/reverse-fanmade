<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" />
    <Compile Include="../traffic/*.cs" Link="Traffic/%(Filename)%(Extension)" />
    <EmbeddedResource Include="Persistence/Schema/001_saves.sql;contract.json;responses.json" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.14" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
  </ItemGroup>
  <ItemGroup>
    <None Update="Start-Backend.cmd;Start-FieldTest.ps1" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <PropertyGroup Condition="'$(PublishSingleFile)' == 'true'">
    <IsTransformWebConfigDisabled>true</IsTransformWebConfigDisabled>
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
  </PropertyGroup>
  <ItemGroup Condition="'$(PublishSingleFile)' == 'true'">
    <Content Remove="artifacts/**" />
    <None Remove="artifacts/**" />
    <Content Update="appsettings.json;contract.json;responses.json" ExcludeFromSingleFile="false" />
    <Content Update="global.json" CopyToPublishDirectory="Never" />
    <None Update="Start-Backend.cmd;Start-FieldTest.ps1" CopyToPublishDirectory="Never" />
  </ItemGroup>
  <ItemGroup><InternalsVisibleTo Include="Provider.Tests" /></ItemGroup>
</Project>
