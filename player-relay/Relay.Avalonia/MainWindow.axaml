<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ReVerse.Relay.Desktop.MainWindow"
        Title=""
        Icon="/Assets/relay-icon.png"
        Width="560"
        Height="700"
        MinWidth="500"
        MinHeight="620"
        WindowStartupLocation="CenterScreen">
  <Grid RowDefinitions="74,*">
    <Border Grid.Row="0" Background="#100E0D" BorderBrush="#39322D" BorderThickness="0,0,0,1">
      <Grid Margin="24,0" ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="12">
        <TextBlock x:Name="BrandText" Grid.Column="0" FontFamily="Impact,DejaVu Sans" FontSize="23" HorizontalAlignment="Center" VerticalAlignment="Center">
          <TextBlock.Inlines><Run x:Name="BrandPrefixRun" Text="" /><Run x:Name="BrandAccentRun" Text="" Foreground="#C7212B" /><Run x:Name="BrandSuffixRun" Text="" /></TextBlock.Inlines>
        </TextBlock>

        <Button x:Name="GuideButton"
                Grid.Column="1"
                Classes="compact"
                Height="34"
                VerticalAlignment="Center"
                IsVisible="False"
                Content=""
                ToolTip.Tip=""
                Click="OnGuideClicked" />

        <Button x:Name="DiscordButton"
                Grid.Column="2"
                Classes="secondary"
                Width="34"
                Height="34"
                Padding="0"
                VerticalAlignment="Center"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                ToolTip.Tip=""
                Click="OnDiscordClicked">
          <Image Source="/Assets/ds-logo.png" Width="20" Height="16" Stretch="Uniform" />
        </Button>

        <ComboBox x:Name="LanguageSelector"
                  Grid.Column="3"
                  Classes="language-selector"
                  VerticalAlignment="Center"
                  SelectionChanged="OnLanguageSelectionChanged">
          <ComboBox.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding LanguageName}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>

        <Button x:Name="HostToggleButton"
                Grid.Column="4"
                Classes="secondary"
                Height="34"
                VerticalAlignment="Center"
                Content=""
                ToolTip.Tip=""
                Click="OnHostToggleClicked" />
      </Grid>
    </Border>

    <Grid x:Name="ContentGrid" Grid.Row="1" ColumnDefinitions="*,0">
      <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,25,28,28" Spacing="0">
          <Grid ColumnDefinitions="*" Margin="0,0,0,22">
            <StackPanel Spacing="5">
              <TextBlock x:Name="PlayerRelayTitleText" FontFamily="Georgia,DejaVu Serif" FontSize="20" />
              <TextBlock x:Name="PlayerRelayDescriptionText" Classes="helper" />
            </StackPanel>
          </Grid>

          <StackPanel Spacing="0">
            <TextBlock x:Name="UsernameLabelText" Classes="label" />
            <TextBox x:Name="UsernameEntry" Classes="form-field" MaxLength="64" />
          </StackPanel>
          <TextBox x:Name="SecretEntry" IsVisible="False" />

          <StackPanel Margin="0,18,0,0" Spacing="0">
            <StackPanel Orientation="Horizontal">
              <TextBlock x:Name="BackendServerLabelText" Classes="label" VerticalAlignment="Center" />
              <Border x:Name="BackendServerHelp" Classes="help" ToolTip.Tip="">
                <TextBlock Text="?" Classes="help-glyph" />
              </Border>
            </StackPanel>
            <TextBox x:Name="BackendEntry" Classes="form-field" KeyDown="OnBackendKeyDown" />
          </StackPanel>

          <StackPanel Margin="0,18,0,0" Spacing="0">
            <StackPanel Orientation="Horizontal">
              <TextBlock x:Name="ServerApiKeyLabelText" Classes="label" VerticalAlignment="Center" />
              <Border x:Name="ServerApiKeyHelp" Classes="help" ToolTip.Tip="">
                <TextBlock Text="?" Classes="help-glyph" />
              </Border>
            </StackPanel>
            <TextBox x:Name="ServerApiKeyEntry" Classes="form-field" PasswordChar="•" MaxLength="128" KeyDown="OnBackendKeyDown" />
          </StackPanel>

          <Border Margin="0,22,0,0" BorderBrush="#39322D" BorderThickness="0,1,0,0" Padding="0,20,0,0">
            <StackPanel Spacing="0">
              <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="SteamLaunchOptionLabelText" Classes="label" VerticalAlignment="Center" />
                <Border x:Name="SteamLaunchOptionHelp" Classes="help" ToolTip.Tip="">
                  <TextBlock Text="?" Classes="help-glyph" />
                </Border>
              </StackPanel>
              <Grid ColumnDefinitions="*,70">
                <TextBox x:Name="LaunchOptionsEntry" Classes="form-field" IsReadOnly="True" />
                <Button x:Name="CopyButton" Grid.Column="1" Classes="compact" Margin="0,7,0,0" Content="" ToolTip.Tip="" Click="OnCopyClicked" />
              </Grid>
            </StackPanel>
          </Border>

          <StackPanel Margin="0,24,0,0" Spacing="0">
            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
              <Button x:Name="StartGameButton" Classes="primary" IsEnabled="False" ToolTip.Tip="" Click="OnStartGameClicked">
                <TextBlock>
                  <TextBlock.Inlines>
                    <InlineUIContainer BaselineAlignment="Baseline">
                      <Path Data="M0,0 L6,3.5 L0,7 Z" Margin="0,0,5,0" Fill="{Binding $parent[TextBlock].Foreground}" />
                    </InlineUIContainer>
                    <Run x:Name="StartGameText" />
                  </TextBlock.Inlines>
                </TextBlock>
              </Button>
              <Button x:Name="ToggleButton" Grid.Column="1" Classes="primary" Content="" ToolTip.Tip="" Click="OnToggleClicked" />
            </Grid>
            <Grid Margin="1,10,1,0" ColumnDefinitions="*,Auto">
              <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                <Border Width="7" Height="7" x:Name="StatusDot" Background="#5E5751" VerticalAlignment="Center" />
                <TextBlock x:Name="StatusText" FontFamily="Consolas,DejaVu Sans Mono" FontSize="9" Foreground="#8B8278" />
              </StackPanel>
              <TextBlock x:Name="RelayPortsText" Grid.Column="1" Classes="label" Foreground="#5E5751" />
            </Grid>
          </StackPanel>
          <StackPanel Margin="0,20,0,0" Spacing="7">
            <Button x:Name="DetailedLogsButton" Classes="secondary" Height="36" Click="OnDetailedLogsClicked" />
            <TextBlock x:Name="DetailedLogsDescriptionText" Classes="helper" TextWrapping="Wrap" />
            <TextBlock x:Name="DetailedLogsPathText" Classes="helper" TextWrapping="Wrap" IsVisible="False" />
          </StackPanel>
          <TextBlock x:Name="ErrorText" IsVisible="False" Margin="0,10,0,0" Foreground="#E05A62" FontFamily="Consolas,DejaVu Sans Mono" FontSize="10" TextWrapping="Wrap" />
          <Button x:Name="ClosePortOwnersButton" Classes="secondary" Height="36" Margin="0,8,0,0" HorizontalAlignment="Stretch" IsVisible="False" Click="OnClosePortOwnersClicked" />
        </StackPanel>
      </ScrollViewer>

      <Border x:Name="BackendHostPanel" Grid.Column="1" IsVisible="False" BorderBrush="#39322D" BorderThickness="1,0,0,0">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="28,25,28,28" Spacing="0">
            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,22">
              <StackPanel Spacing="5">
                <TextBlock x:Name="BackendHostTitleText" FontFamily="Georgia,DejaVu Serif" FontSize="20" />
                <TextBlock x:Name="BackendHostDescriptionText" Classes="helper" />
              </StackPanel>
            </Grid>

            <StackPanel Spacing="0">
              <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="BackendFolderLabelText" Classes="label" VerticalAlignment="Center" />
                <Border x:Name="BackendFolderHelp" Classes="help" ToolTip.Tip="">
                  <TextBlock Text="?" Classes="help-glyph" />
                </Border>
              </StackPanel>
              <Grid ColumnDefinitions="*,82">
                <TextBox x:Name="HostFolderEntry" Classes="form-field" TextChanged="OnHostConfigurationChanged" />
                <Button x:Name="BrowseBackendButton" Grid.Column="1" Classes="compact" Margin="0,7,0,0" Content="" ToolTip.Tip="" Click="OnBrowseBackendFolder" />
              </Grid>
              <TextBlock x:Name="BackendFolderStatusText" Classes="helper" IsVisible="False" Margin="1,7,0,0" Foreground="#C7212B" TextWrapping="Wrap" />
            </StackPanel>

            <Grid Margin="0,16,0,0" ColumnDefinitions="*,128,128" ColumnSpacing="14">
              <StackPanel Spacing="0">
                <StackPanel Orientation="Horizontal">
                  <TextBlock x:Name="ZeroTierAddressLabelText" Classes="label" VerticalAlignment="Center" />
                  <Border x:Name="ZeroTierAddressHelp" Classes="help" ToolTip.Tip="">
                    <TextBlock Text="?" Classes="help-glyph" />
                  </Border>
                </StackPanel>
                <Grid ColumnDefinitions="*,76">
                  <TextBox x:Name="ZeroTierAddressEntry" Classes="form-field" TextChanged="OnHostConfigurationChanged" />
                  <Button x:Name="DetectAddressButton" Grid.Column="1" Classes="compact" Margin="0,7,0,0" Content="" ToolTip.Tip="" Click="OnDetectAddress" />
                </Grid>
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="0">
                <StackPanel Orientation="Horizontal">
                  <TextBlock x:Name="PlayersLabelText" Classes="label" VerticalAlignment="Center" />
                  <Border x:Name="PlayersHelp" Classes="help" ToolTip.Tip="">
                    <TextBlock Text="?" Classes="help-glyph" />
                  </Border>
                </StackPanel>
                <NumericUpDown x:Name="PlayersEntry" Classes="form-field" Minimum="2" Maximum="10" Increment="1" FormatString="0" ValueChanged="OnPlayerCountChanged" />
              </StackPanel>
              <StackPanel Grid.Column="2" Spacing="0">
                <StackPanel Orientation="Horizontal">
                  <TextBlock x:Name="FillWaitLabelText" Classes="label" VerticalAlignment="Center" />
                  <Border x:Name="FillWaitHelp" Classes="help" ToolTip.Tip="">
                    <TextBlock Text="?" Classes="help-glyph" />
                  </Border>
                </StackPanel>
                <NumericUpDown x:Name="FillWaitEntry" Classes="form-field" Minimum="0" Maximum="100" Increment="5" FormatString="0" ValueChanged="OnPlayerCountChanged" />
              </StackPanel>
            </Grid>
            <TextBlock x:Name="ZeroTierStatusText" IsVisible="False" Margin="1,7,0,0" FontFamily="Consolas,DejaVu Sans Mono" FontSize="9" Foreground="#5E5751" TextWrapping="Wrap" />

            <StackPanel Margin="0,16,0,0" Spacing="0">
              <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="HostApiKeyLabelText" Classes="label" VerticalAlignment="Center" />
                <Border x:Name="HostApiKeyHelp" Classes="help" ToolTip.Tip="">
                  <TextBlock Text="?" Classes="help-glyph" />
                </Border>
              </StackPanel>
              <Grid ColumnDefinitions="*,92,70">
                <TextBox x:Name="HostApiKeyEntry" Classes="form-field" MaxLength="128" TextChanged="OnHostConfigurationChanged" />
                <Button x:Name="GenerateApiKeyButton" Grid.Column="1" Classes="compact" Margin="0,7,0,0" Content="" ToolTip.Tip="" Click="OnGenerateApiKey" />
                <Button x:Name="CopyApiKeyButton" Grid.Column="2" Classes="compact" Margin="6,7,0,0" Content="" ToolTip.Tip="" Click="OnCopyApiKeyClicked" />
              </Grid>
            </StackPanel>

            <Border Margin="0,22,0,0" BorderBrush="#39322D" BorderThickness="0,1,0,0" Padding="0,20,0,0">
              <StackPanel Spacing="0">
                <TextBlock x:Name="PlayerConnectionUrlLabelText" Classes="label" />
                <Grid ColumnDefinitions="*,70">
                  <TextBox x:Name="PlayerBackendUrlEntry" Classes="form-field" IsReadOnly="True" />
                  <Button x:Name="CopyBackendUrlButton" Grid.Column="1" Classes="compact" Margin="0,7,0,0" Content="" IsEnabled="False" ToolTip.Tip="" Click="OnCopyBackendUrlClicked" />
                </Grid>
                <TextBlock x:Name="PlayerConnectionUrlDescriptionText" Classes="helper" Margin="1,7,0,0" TextWrapping="Wrap" />
              </StackPanel>
            </Border>

            <StackPanel Margin="0,20,0,0" Spacing="7">
              <Button x:Name="UdpLoggingButton" Classes="secondary" Height="36" Click="OnUdpLoggingClicked" />
              <TextBlock x:Name="UdpLoggingDescriptionText" Classes="helper" TextWrapping="Wrap" />
            </StackPanel>

            <Expander x:Name="AdvancedCommandExpander" Margin="0,17,0,0" Header="" FontFamily="Consolas,DejaVu Sans Mono" FontSize="9" Foreground="#8B8278">
              <TextBox x:Name="BackendCommandEntry" Classes="form-field" Height="94" AcceptsReturn="False" TextWrapping="Wrap" FontSize="10" TextChanged="OnBackendCommandChanged" />
            </Expander>

            <StackPanel Margin="0,24,0,0" Spacing="0">
              <Grid ColumnDefinitions="*,86" ColumnSpacing="8">
                <Button x:Name="StartBackendButton" Classes="primary" Content="" ToolTip.Tip="" Click="OnStartBackend" />
                <Button x:Name="StopBackendButton" Grid.Column="1" Classes="primary" Height="48" Content="" IsEnabled="False" ToolTip.Tip="" Click="OnStopBackend" />
              </Grid>
              <Grid Margin="1,10,1,0" ColumnDefinitions="*,Auto">
                <TextBlock x:Name="BackendHostStatusText" FontFamily="Consolas,DejaVu Sans Mono" FontSize="9" Foreground="#8B8278" TextWrapping="Wrap" />
                <TextBlock x:Name="BackendPortsText" Grid.Column="1" Classes="label" Foreground="#5E5751" />
              </Grid>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>

    <Border x:Name="BusyOverlay" Grid.RowSpan="2" IsVisible="False" Background="#D9090807">
      <StackPanel Width="210" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
        <ProgressBar IsIndeterminate="True" Height="3" Foreground="#C7212B" />
        <TextBlock x:Name="PleaseWaitText" HorizontalAlignment="Center" Classes="label" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
